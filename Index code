    </div>

</div>


<div class="note">

    <b>One Way Fare</b><br>

    ₹15/KM • Minimum 130 KM • Driver Allowance ₹400

    <br>

    Toll / Permit / Parking / Waiting charges extra.

</div>


<!-- BOOKING -->

<section id="booking">

<h2>Book Your Taxi</h2>

<form id="bookingForm">


<!-- SERVICE TYPE -->

<label for="service">
    Service Type
</label>

<select id="service" required>

    <option value="Share Taxi">
        Share Taxi
    </option>

    <option value="One Way">
        One Way
    </option>

</select>


<!-- VEHICLE TYPE -->
<!-- ONLY SHOWS FOR ONE WAY -->

<div id="vehicleBox">

    <label for="vehicle">
        Vehicle Type
    </label>

    <select id="vehicle">

        <option value="">
            Select Vehicle
        </option>

        <option value="Sedan">
            🚗 Sedan
        </option>

        <option value="SUV">
            🚙 SUV
        </option>

    </select>

</div>


<!-- DATE -->

<label for="date">
    Travel Date
</label>

<input
    type="date"
    id="date"
    required
>


<!-- PICKUP -->

<label for="pickup">
    Pickup Location
</label>

<input
    type="text"
    id="pickup"
    placeholder="Pickup location"
    required
>


<!-- DROP -->

<label for="drop">
    Drop Location
</label>

<input
    type="text"
    id="drop"
    placeholder="Drop location"
    required
>


<!-- PASSENGERS -->

<label for="passengers">
    Passengers
</label>

<input
    type="number"
    id="passengers"
    min="1"
    value="1"
    required
>


<!-- TIME -->

<label for="time">
    Pickup Time
</label>

<input
    type="time"
    id="time"
    required
>


<!-- NAME -->

<label for="name">
    Passenger Name
</label>

<input
    type="text"
    id="name"
    placeholder="Your name"
    required
>


<!-- MOBILE -->

<label for="mobile">
    Mobile Number
</label>

<input
    type="tel"
    id="mobile"
    placeholder="10 digit mobile number"
    required
>


<button
    type="submit"
    class="submit-btn"
>
    BOOK NOW ON WHATSAPP
</button>


<a
    class="whatsapp"
    href="https://wa.me/918940694977"
>
    WhatsApp: 8940694977
</a>

</form>

</section>

</div>


<footer>

© 2026 IFRAH CABS • Guiding Every Journey

</footer>


<script>

/* =====================================
   SHOW VEHICLE ONLY FOR ONE WAY
===================================== */

const service =
    document.getElementById("service");

const vehicleBox =
    document.getElementById("vehicleBox");

const vehicle =
    document.getElementById("vehicle");


function updateVehicle() {

    if (service.value === "One Way") {

        // Show vehicle
        vehicleBox.style.display = "block";

        // Vehicle required
        vehicle.required = true;

    } else {

        // Hide vehicle
        vehicleBox.style.display = "none";

        // Vehicle not required
        vehicle.required = false;

        // Clear selection
        vehicle.value = "";

    }

}


/* When service changes */

service.addEventListener(
    "change",
    updateVehicle
);


/* Run when page opens */

updateVehicle();



