<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>IFRAH CABS | Share Taxi & One Way</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f7fa;
    color: #172033;
}

/* TOP BAR */
.top {
    position: sticky;
    top: 0;
    z-index: 100;
    background: white;
    padding: 14px 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 2px 12px rgba(0,0,0,0.10);
}

.logo {
    font-size: 23px;
    font-weight: 800;
    letter-spacing: 1px;
}

.book-btn {
    background: #111;
    color: white;
    text-decoration: none;
    padding: 11px 18px;
    border-radius: 25px;
    font-weight: bold;
}

/* HERO */
.hero {
    padding: 65px 20px;
    text-align: center;
    background: linear-gradient(135deg, #111827, #334155);
    color: white;
}

.hero h1 {
    font-size: 38px;
    margin: 0 0 12px;
}

.hero p {
    font-size: 18px;
    margin: 0;
}

/* CONTENT */
.container {
    max-width: 900px;
    margin: auto;
    padding: 30px 16px;
}

h2 {
    text-align: center;
    margin-bottom: 22px;
}

/* FARE CARDS */
.fare-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
}

.card {
    background: white;
    padding: 22px;
    border-radius: 18px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}

.card h3 {
    font-size: 23px;
    margin-top: 0;
}

.price {
    font-size: 28px;
    font-weight: 800;
    margin: 12px 0;
}

.card li {
    line-height: 1.9;
}

.note {
    background: #fff8df;
    padding: 15px;
    border-radius: 12px;
    margin: 20px 0;
    text-align: center;
}

/* BOOKING FORM */
form {
    background: white;
    padding: 22px;
    border-radius: 18px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
}

label {
    display: block;
    font-weight: bold;
    margin: 13px 0 6px;
}

input,
select {
    width: 100%;
    padding: 13px;
    border: 1px solid #d5dbe5;
    border-radius: 10px;
    font-size: 16px;
    background: white;
}

.submit-btn {
    width: 100%;
    border: none;
    background: #159447;
    color: white;
    padding: 15px;
    border-radius: 12px;
    font-size: 17px;
    font-weight: 800;
    margin-top: 20px;
    cursor: pointer;
}

.whatsapp {
    display: block;
    text-align: center;
    margin-top: 14px;
    color: #159447;
    font-weight: bold;
}

footer {
    text-align: center;
    padding: 30px;
    color: #667085;
}

/* VEHICLE HIDDEN BY DEFAULT */
#vehicleBox {
    display: none;
}
</style>
</head>

<body>

<!-- TOP -->
<header class="top">
    <div class="logo">IFRAH CABS</div>

    <a href="#booking" class="book-btn">
        BOOK NOW
    </a>
</header>


<!-- HERO -->
<section class="hero">

