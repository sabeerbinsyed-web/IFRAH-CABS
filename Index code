    <p>
        Safe • Reliable • On Time • 24/7 Service
    </p>

</section>


<div class="container">

<!-- FARE SECTION -->

<h2>Our Fare</h2>

<div class="fare-cards">

    <!-- SHARE TAXI -->
    <div class="card">

        <h3>🚕 Share Taxi</h3>

        <div class="price">
            Airport Share Taxi
        </div>

        <ul>

            <li>
                Chennai Airport → Sirkali — ₹3,000
            </li>

            <li>
                Chennai Airport → Chidambaram — ₹3,000
